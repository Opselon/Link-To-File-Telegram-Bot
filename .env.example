# ⚡ Link → File — configuration
# Copy to .env (or run `python main.py --setup`) and fill in the first two.

# --- Required ---------------------------------------------------------------
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
ADMIN_ID=123456789

# --- Limits -----------------------------------------------------------------
# Telegram caps uploads at 2000 MB. Without a self-hosted API server the cloud
# limit is 50 MB, so keep this at 50 unless you run one.
MAX_FILE_SIZE_MB=2000
DOWNLOAD_TIMEOUT=600
QUEUE_TASK_TIMEOUT=1800

# --- Concurrency / speed ----------------------------------------------------
QUEUE_CONCURRENCY=3
QUEUE_MAX_SIZE=200
RATE_LIMIT_SECONDS=3
PREVIEW_TIMEOUT=12
DOWNLOAD_CHUNK_KB=256
UPLOAD_CHUNK_KB=1024
YTDLP_FRAGMENTS=8
PROGRESS_INTERVAL_MS=1500

# --- Housekeeping -----------------------------------------------------------
# Refuse new work below this much free disk (MB)
MIN_FREE_DISK_MB=512
# Delete orphaned temp files older than this (seconds)
TEMP_FILE_TTL=900
# Max downloads a single user may have queued+running
MAX_PENDING_PER_USER=2

# --- Optional ---------------------------------------------------------------
# Self-hosted Bot API server, e.g. http://127.0.0.1:8081 (raises uploads to 2 GB)
TELEGRAM_API_URL=
# Egress proxy for blocked sites: socks5://127.0.0.1:9050 or http://proxy:3128
PROXY_URL=
# Media-only proxy (overrides PROXY_URL for yt-dlp)
YTDLP_PROXY=
# Netscape cookies.txt (fixes YouTube "confirm you're not a bot")
YTDLP_COOKIES_FILE=
# Optional BotFather display name override
BOT_DISPLAY_NAME=
# Where the database, logs and temporary files live (default: project folder)
DATA_DIR=
LOG_LEVEL=INFO

# --- Force join (v3) --------------------------------------------------------
# Configured from the /admin dashboard instead of env vars; nothing to set here.
# /admin -> "📢 Channel" -> send @yourchannel -> toggle "🔒 Force join: ON".
